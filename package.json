{
  "name": "bootanimforge",
  "version": "1.1.0",
  "private": true,
  "description": "把 MP4 等视频转成安卓开机动画（bootanimation.zip）的 Windows 工具：Material Design 3 界面、零依赖 Node 引擎、支持 Android 12+ 视频版格式、Magisk 模块一键生成，且无需预装 Node",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node src/main.js --no-open",
    "fetch-ffmpeg": "node tools/fetch-ffmpeg.js",
    "selftest": "node tools/selftest.js",
    "make-portable": "node tools/make-portable.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["android", "bootanimation", "ffmpeg", "mp4", "material-design-3", "magisk", "wear-os"],
  "license": "MIT"
}

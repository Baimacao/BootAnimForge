<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      瑞士国际主义风格色板（与 PC 端 public/css/app.css 的令牌一一对应，两端观感统一）。

      为什么不用 Material Components 库：本机 Maven 仓库不可达，拿不到 androidx，
      所以这里把色板写成普通资源，由 framework 控件自己实现。

      只保留 styles.xml 实际引用的 4 个颜色。
      原先的 md_space_*（6 个）、md_shape_*（4 个）、md_ripple 在整个工程里零引用，已删除；
      间距与圆角由 Java 侧的 Palette / dp() 统一控制（实测 Java 不引用任何 R.color / R.dimen）。
    -->
    <color name="md_primary">#DA291C</color>
    <color name="md_surface">#F5F2ED</color>
    <color name="md_on_surface">#1A1A1A</color>
    <color name="md_on_surface_variant">#B81A1A1A</color>
</resources>
